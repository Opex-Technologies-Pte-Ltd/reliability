{
  "name": "@opexcg/reliability",
  "version": "0.1.0",
  "description": "Reliability and condition-monitoring math in TypeScript: Weibull fitting (rank regression and MLE with suspensions), B-life, remaining useful life, Weibull proportional hazards, MTBF/MTTR/availability, PCA with Hotelling T² and SPE limits",
  "license": "Apache-2.0",
  "author": "Opex Technologies Pte. Ltd. (https://mx.opexcg.com)",
  "homepage": "https://github.com/Opex-Technologies-Pte-Ltd/reliability#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Opex-Technologies-Pte-Ltd/reliability.git"
  },
  "bugs": "https://github.com/Opex-Technologies-Pte-Ltd/reliability/issues",
  "keywords": [
    "reliability",
    "weibull",
    "mtbf",
    "mttr",
    "availability",
    "remaining-useful-life",
    "survival-analysis",
    "censored-data",
    "proportional-hazards",
    "pca",
    "hotelling",
    "condition-monitoring",
    "predictive-maintenance"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
